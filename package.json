{
  "name": "vscode-color-palette-creator",
  "displayName": "Color Palette Creator",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "bsesic",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1F2A44",
    "theme": "dark"
  },
  "homepage": "https://github.com/bsesic/VSCodeColorPaletteCreator#readme",
  "bugs": {
    "url": "https://github.com/bsesic/VSCodeColorPaletteCreator/issues"
  },
  "sponsor": {
    "url": "https://www.buymeacoffee.com/bsesic"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bsesic/VSCodeColorPaletteCreator.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "color",
    "color picker",
    "palette",
    "color palette",
    "gradient",
    "contrast",
    "wcag",
    "accessibility",
    "color blindness",
    "eyedropper",
    "css",
    "scss",
    "tailwind",
    "bootstrap",
    "theme"
  ],
  "main": "./out/extension/src/extension/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "colorPaletteCreator.open",
        "title": "%command.open%",
        "category": "%category%",
        "icon": "$(symbol-color)"
      },
      {
        "command": "colorPaletteCreator.openDocumentColors",
        "title": "%command.openDocumentColors%",
        "category": "%category%",
        "icon": "$(edit)"
      },
      {
        "command": "colorPaletteCreator.openImageExtraction",
        "title": "%command.openImageExtraction%",
        "category": "%category%",
        "icon": "$(file-media)"
      },
      {
        "command": "colorPaletteCreator.openGradientGenerator",
        "title": "%command.openGradientGenerator%",
        "category": "%category%"
      },
      {
        "command": "colorPaletteCreator.openContrastChecker",
        "title": "%command.openContrastChecker%",
        "category": "%category%"
      },
      {
        "command": "colorPaletteCreator.openColorBlindnessSimulator",
        "title": "%command.openColorBlindnessSimulator%",
        "category": "%category%"
      },
      {
        "command": "colorPaletteCreator.openSavedPalettes",
        "title": "%command.openSavedPalettes%",
        "category": "%category%"
      },
      {
        "command": "colorPaletteCreator.openHistory",
        "title": "%command.openHistory%",
        "category": "%category%"
      },
      {
        "command": "colorPaletteCreator.insertPalette",
        "title": "%command.insertPalette%",
        "category": "%category%"
      },
      {
        "command": "colorPaletteCreator.exportPalette",
        "title": "%command.exportPalette%",
        "category": "%category%"
      },
      {
        "command": "colorPaletteCreator.importPalette",
        "title": "%command.importPalette%",
        "category": "%category%"
      },
      {
        "command": "colorPaletteCreator.toggleInlineColors",
        "title": "%command.toggleInlineColors%",
        "category": "%category%"
      },
      {
        "command": "colorPaletteCreator.clearHistory",
        "title": "%command.clearHistory%",
        "category": "%category%"
      }
    ],
    "keybindings": [
      {
        "command": "colorPaletteCreator.open",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "colorPaletteCreator.openDocumentColors",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "colorPaletteCreator.openDocumentColors",
          "group": "z_colorPalette@1"
        },
        {
          "command": "colorPaletteCreator.insertPalette",
          "group": "z_colorPalette@2",
          "when": "editorTextFocus && !editorReadonly"
        }
      ],
      "explorer/context": [
        {
          "command": "colorPaletteCreator.openImageExtraction",
          "group": "z_colorPalette",
          "when": "resourceExtname =~ /\\.(png|jpe?g|gif|webp|bmp)$/i"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "colorPaletteCreator.historySize": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 500,
          "description": "%configuration.historySize%"
        },
        "colorPaletteCreator.defaultExportFormat": {
          "type": "string",
          "default": "css",
          "enum": [
            "css",
            "scss",
            "less",
            "json",
            "tailwind",
            "js",
            "ts",
            "gpl",
            "txt"
          ],
          "description": "%configuration.defaultExportFormat%"
        },
        "colorPaletteCreator.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showStatusBarItem%"
        },
        "colorPaletteCreator.inlineColors.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.inlineColors.enabled%"
        },
        "colorPaletteCreator.inlineColors.excludedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.inlineColors.excludedLanguages%"
        },
        "colorPaletteCreator.inlineColors.builtInLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "css",
            "scss",
            "less"
          ],
          "description": "%configuration.inlineColors.builtInLanguages%"
        },
        "colorPaletteCreator.documentColors.autoSave": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.documentColors.autoSave%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('out',{recursive:true,force:true});fs.rmSync('media/out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "watch": "tsc -p tsconfig.json -w",
    "lint": "eslint src test --ext ts",
    "test": "npm run compile && mocha",
    "vscode:prepublish": "npm run compile",
    "precommit": "npm run lint && npm test",
    "package": "vsce package",
    "icon": "node scripts/render-icon.mjs",
    "l10n": "node scripts/extract-l10n.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "~2.6.2",
    "@types/mocha": "^10.0.6",
    "@types/node": "^16.18.0",
    "@types/vscode": "~1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vscode/vsce": "~4.0.0",
    "eslint": "^8.57.0",
    "mocha": "^12.0.3",
    "typescript": "~5.4.5"
  }
}
