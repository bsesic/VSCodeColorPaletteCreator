{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "media/out",
    "rootDir": "src",
    "strict": true,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["src/core/**/*.ts", "src/webview/**/*.ts"]
}
